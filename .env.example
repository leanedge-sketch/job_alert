TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Secondary source. Google Alerts often deliver nothing for days, so the bot no
# longer depends on it — LinkedIn guest search (below) is the primary source.
RSS_FEED_URLS=https://www.google.com/alerts/feeds/FEED_1,https://www.google.com/alerts/feeds/FEED_2,https://www.google.com/alerts/feeds/FEED_3,https://www.google.com/alerts/feeds/FEED_4

# Notion tracking database
# Required DB properties (exact names/types):
#   Position (Title)
#   Link (URL)
#   Date Found (Date)
#   Status (Status) — include option "To Apply"
#   Match Score (Number)
#   Keywords (Multi-select)
#   Applied (Checkbox)
#   Note (Rich text)
NOTION_API_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id
# CV Vault database (Active checkbox + Minimum Score number + page body CV text)
NOTION_CV_VAULT_ID=your_cv_vault_database_id

# Gemini job scoring (required for alerts)
GEMINI_API_KEY=your_gemini_api_key

# --- Optional tuning (sane defaults; only set to override) --------------------

# Gemini free tier allows ~20 requests/day. The bot rations itself below that so
# it never starts returning 0% "AI Parse Failed" scores mid-run.
GEMINI_MAX_CALLS_PER_DAY=18
GEMINI_MAX_CALLS_PER_RUN=8
# Calls held back for on-demand "Generate pack" button taps.
GEMINI_PACK_RESERVE=2
# Seconds between Gemini calls.
GEMINI_CALL_SPACING_SECONDS=2

# Never alert below this score, even if a CV's Notion Minimum Score is 0.
MIN_ALERT_SCORE=40

# Primary sources: LinkedIn guest search + Google News discovery for
# Indeed / Bayt / Naukrigulf (those boards block direct scrapes).
LINKEDIN_SEARCH_ENABLED=true
LINKEDIN_SEARCH_HOURS=24
LINKEDIN_MAX_JOBS=30
INDEED_SEARCH_ENABLED=true
BAYT_SEARCH_ENABLED=true
NAUKRIGULF_SEARCH_ENABLED=true
BOARD_MAX_JOBS=15

# Telegram status digest every N hours so silence != breakage. 0 disables.
HEARTBEAT_HOURS=24

# Free tier: no GOOGLE_API_KEY / GOOGLE_CSE_ID.
# Custom Search JSON API is closed to new customers.
# For past-week jobs: edit backfill_week.json then run python send_backfill.py
# Or: python main.py --backfill-days 7  (prints manual Google search links)
