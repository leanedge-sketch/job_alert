TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
RSS_FEED_URLS=https://www.google.com/alerts/feeds/FEED_1,https://www.google.com/alerts/feeds/FEED_2,https://www.google.com/alerts/feeds/FEED_3,https://www.google.com/alerts/feeds/FEED_4

# Notion tracking database
# Required DB properties (exact names/types):
#   Position (Title)
#   Link (URL)
#   Date Found (Date)
#   Status (Status) — uses option "Interested"
NOTION_API_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Gemini job scoring (required for alerts)
GEMINI_API_KEY=your_gemini_api_key

# Optional: for automated past-week backfill (python main.py --backfill-days 7)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id
